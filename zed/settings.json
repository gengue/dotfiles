{
    "edit_predictions": {
        "disabled_globs": [],
        "mode": "eager_preview"
    },
    "features": {
        "edit_prediction_provider": "zed"
    },
    "assistant": {
        "always_allow_tool_actions": true,
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-3-7-sonnet-thinking-latest"
        },
        "version": "2"
    },
    "theme": {
        "mode": "system",
        "dark": "Vesper",
        "light": "Xcode Default Light"
    },
    "buffer_font_family": "Zed Plex Mono",
    "buffer_font_size": 15,
    "vim_mode": true,
    "cursor_blink": false,
    "relative_line_numbers": true,
    "show_wrap_guides": true,
    "scrollbar": {
        "show": "never"
    },
    "tab_bar": {
        "show": false
    },
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": false
    },
    "vertical_scroll_margin": 0,
    "gutter": {
        "line_numbers": true,
        "code_actions": true,
        "folds": true
    },
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
            "delay_ms": 5000
        }
    },
    "lsp": {
        "biome": {
            "settings": {
                "require_config_file": true
            }
        }
    },
    "languages": {
        "Go": {
            "code_actions_on_format": {
                "source.organizeImports": true
            }
        }
    },
    "experimental.theme_overrides": {},
    "context_servers": {
        "codebase-memory-mcp": {
            "command": "/home/genesis/.local/bin/codebase-memory-mcp",
            "args": [
                ""
            ]
        }
    }
}
